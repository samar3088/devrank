APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# DevRank AI (coding-quiz grading / proctoring). Leave disabled for a no-cost
# phase-1 launch: quizzes run MCQ-only and no Anthropic API calls are made.
DEVRANK_AI_ENABLED=false
# ANTHROPIC_API_KEY=
# DEVRANK_AI_MODEL=claude-sonnet-4-6

# Real-time notifications (Reverb WebSocket) — OPTIONAL. Default off: the bell
# updates via 45s polling. To enable, set BROADCAST_CONNECTION=reverb, fill the
# REVERB_* + matching VITE_REVERB_* below, run `php artisan reverb:start`, and
# `npm run build`. Broadcasting stays a no-op while BROADCAST_CONNECTION=log/null.
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=devrank
# REVERB_APP_KEY=local-key
# REVERB_APP_SECRET=local-secret
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Judge0 objective code execution (#1) — unlocks coding questions/challenges by
# grading submissions against hidden test cases. Self-host (https://github.com/judge0/judge0)
# or use RapidAPI. Coding stays off until JUDGE0_URL is set.
# JUDGE0_URL=http://localhost:2358
# JUDGE0_KEY=            # RapidAPI key (omit for self-hosted)
# JUDGE0_HOST=           # RapidAPI host header (omit for self-hosted)
# JUDGE0_TIMEOUT=20

# GitHub import (verified rank signal). Register an OAuth app at
# https://github.com/settings/developers with callback <APP_URL>/auth/github/callback.
# The "Connect GitHub" UI + routes only appear when GITHUB_CLIENT_ID is set.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# Verifiable rank credentials (#2) — keys the optional badge HMAC receipt; defaults to APP_KEY.
# DEVRANK_CREDENTIAL_SECRET=

# DPDP / privacy — data-fiduciary details shown in the privacy notice & grievance flow.
# DEVRANK_ENTITY_NAME=DevRank
# DEVRANK_GRIEVANCE_EMAIL=privacy@devrank.com
# DEVRANK_GRIEVANCE_OFFICER="Data Protection Officer"
